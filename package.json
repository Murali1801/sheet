{
  "name": "@murali1801/sheet",
  "version": "0.1.0",
  "private": true,
  "description": "A zero-dependency <bottom-sheet> Web Component with native-app physics: velocity projection, springs, rubber banding and nested scroll.",
  "type": "module",
  "license": "MIT",
  "author": "Muralidhar Acharya (https://github.com/Murali1801)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Murali1801/sheet"
  },
  "keywords": [
    "bottom-sheet",
    "web-component",
    "custom-element",
    "drawer",
    "sheet",
    "spring",
    "physics",
    "dialog"
  ],
  "module": "./dist/bottom-sheet.js",
  "types": "./dist/bottom-sheet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bottom-sheet.d.ts",
      "import": "./dist/bottom-sheet.js"
    },
    "./min": "./dist/bottom-sheet.min.js",
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/bottom-sheet.js",
    "./dist/bottom-sheet.min.js",
    "./src/bottom-sheet.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build -c vite.lib.config.ts && vite build -c vite.lib.config.ts --mode min && tsc -p tsconfig.lib.json && vite build && node scripts/size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
